# The War Room — Environment Variables
# Copy to .env and fill in values

# App
DEBUG=false
# API key auth: leave empty to disable (local use). If you set it, every
# /api request needs it, so also set NEXT_PUBLIC_API_KEY to the same value
# for the frontend build.
SECRET_KEY=

# Bybit API (leave empty for public-only data collection)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# TradingView Webhook
WEBHOOK_SECRET=change-me-webhook-secret

# Risk Management
RISK_PER_TRADE_PCT=2.5
MAX_POSITIONS_LONG=10
MAX_POSITIONS_SHORT=10
MAX_POSITIONS_TOTAL=20
DAILY_LOSS_LIMIT_PCT=5.0
DEFAULT_LEVERAGE=1

# Trading Mode
PAPER_TRADING=true
PAPER_INITIAL_BALANCE=10000
PAPER_SLIPPAGE_PCT=0.01

# Live Engine
LIVE_ENGINE_ENABLED=true
